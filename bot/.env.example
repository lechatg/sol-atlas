# ========================================
# SOL-ATLAS BOT - MINIMAL CONFIGURATION
# Copy this to .env and fill in your values
# ========================================

# === REQUIRED ===
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN

# === LLM PROVIDER (Choose ONE) ===
# Option A: OpenAI
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL_NAME=gpt-4-turbo

# Option B: Ollama
# DEFAULT_LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL_NAME=gpt-oss


# === OPTIONAL FEATURES (Disable for minimal setup) ===
WAREHOUSE_ENABLED=false
CAMUNDA_ENABLED=false
AG_UI_ENABLED=false
METRICS_ENABLED=false

# Redis (for FSM and Cache) Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Webhook Server Settings (Optional)
USE_WEBHOOK=False
WEBHOOK_HOST="0.0.0.0"  # use "localhost" if not using Docker
WEBHOOK_PORT=8080
WEBHOOK_BASE_URL="https://example.com"
WEBHOOK_PATH="/webhook"
WEBHOOK_SECRET="secret"
